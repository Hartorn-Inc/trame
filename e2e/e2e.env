# Test-only values for the production-image E2E stack (`make e2e`).
# Never reuse these secrets outside this throwaway stack.
TRAME_IMAGE=trame-server:e2e
# Required by the prod file's Caddy service, which `make e2e` does not start.
TRAME_DOMAIN=localhost
POSTGRES_PASSWORD=e2e_only_postgres_password
MASTER_ENCRYPTION_KEY=e2e0e2e0e2e0e2e0e2e0e2e0e2e0e2e0e2e0e2e0e2e0e2e0e2e0e2e0e2e0e2e0
TRAME_JWT_SECRET=e2e-only-asset-signing-secret-not-for-production
TRAME_INVITE_JWT_SECRET=e2e-only-invite-signing-secret-not-for-production
TRAME_PUBLIC_ORIGIN=http://localhost:8080
TRAME_COOKIE_SECURE=false
RUST_LOG=info
# Assets in Silo (`--profile silo`); storage-init creates the bucket and its
# CORS rule for TRAME_PUBLIC_ORIGIN. Browsers download from the public endpoint.
S3_ENDPOINT=http://silo:9000
S3_PUBLIC_ENDPOINT=http://silo:9000
S3_BUCKET=trame-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=e2e_silo
S3_SECRET_ACCESS_KEY=e2e_only_silo_secret
