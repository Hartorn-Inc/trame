# TRAME Local Development Environment
# Copy to .env and set chmod 600 .env before running `make up`

DATABASE_URL=postgresql://trame:trame_dev_password@postgres:5432/trame
POSTGRES_USER=trame
POSTGRES_PASSWORD=trame_dev_password
POSTGRES_DB=trame

S3_ENDPOINT=http://minio:9000
S3_BUCKET=trame-assets
S3_ACCESS_KEY_ID=trame_minio
S3_SECRET_ACCESS_KEY=trame_minio_secret_key
S3_REGION=auto

TRAME_PORT=8080
TRAME_SESSION_SECRET=CHANGE_ME_TO_A_DIFFERENT_DEV_SECRET_32_CHARS_MIN
TRAME_IDLE_LEASE_SECONDS=900
RUST_LOG=info,trame_server=debug,trame_engine=debug
