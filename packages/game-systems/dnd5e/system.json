  "attribution": "This work includes material taken from the System Reference Document 5.1 (\"SRD 5.1\") by Wizards of the Coast LLC and available at https://dnd.wizards.com/resources/systems-reference-document. The SRD 5.1 is licensed under the Creative Commons Attribution 4.0 International License available at https://creativecommons.org/licenses/by/4.0/legalcode.",
  "actorTypes": ["character", "npc", "monster"],
  "itemTypes": ["weapon", "armor", "shield", "spell", "consumable", "feature", "equipment"],
  "abilities": ["str", "dex", "con", "int", "wis", "cha"],
  "skills": [
    "acrobatics",
    "animal_handling",
    "arcana",
    "athletics",
    "deception",
    "history",
    "insight",
    "intimidation",
    "investigation",
    "medicine",
    "nature",
    "perception",
    "performance",
    "persuasion",
    "religion",
    "sleight_of_hand",
    "stealth",
    "survival"
  ],
  "derivedDAG": {
    "str_mod": "floor((str - 10) / 2)",
    "dex_mod": "floor((dex - 10) / 2)",
    "con_mod": "floor((con - 10) / 2)",
    "int_mod": "floor((int - 10) / 2)",
    "wis_mod": "floor((wis - 10) / 2)",
    "cha_mod": "floor((cha - 10) / 2)",
    "prof_bonus": "floor((level - 1) / 4) + 2",
    "initiative": "dex_mod",
    "ac": "10 + dex_mod + armor_bonus + shield_bonus",
    "spell_save_dc": "8 + prof_bonus + spell_mod",
    "spell_attack_bonus": "prof_bonus + spell_mod",
    "passive_perception": "10 + skill_perception",
    "passive_investigation": "10 + int_mod + floor(skill_investigation_prof * prof_bonus)",
    "passive_insight": "10 + wis_mod + floor(skill_insight_prof * prof_bonus)",
    "save_str": "str_mod + save_str_prof * prof_bonus",
    "save_dex": "dex_mod + save_dex_prof * prof_bonus",
    "save_con": "con_mod + save_con_prof * prof_bonus",
    "save_int": "int_mod + save_int_prof * prof_bonus",
    "save_wis": "wis_mod + save_wis_prof * prof_bonus",
    "save_cha": "cha_mod + save_cha_prof * prof_bonus",
    "skill_athletics": "str_mod + floor(skill_athletics_prof * prof_bonus)",
    "skill_acrobatics": "dex_mod + floor(skill_acrobatics_prof * prof_bonus)",
    "skill_stealth": "dex_mod + floor(skill_stealth_prof * prof_bonus)",
    "skill_arcana": "int_mod + floor(skill_arcana_prof * prof_bonus)",
    "skill_perception": "wis_mod + floor(skill_perception_prof * prof_bonus)",
    "skill_persuasion": "cha_mod + floor(skill_persuasion_prof * prof_bonus)"
  }
}
