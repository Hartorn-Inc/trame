# TRAME production Compose settings. Copy to `deploy/compose/.env`, set the
# REQUIRED values in Section 1, and keep `.env` out of version control
# (`.env` is git-ignored: it holds secrets).
# Generate 64-hex-character secrets with: `openssl rand -hex 32`

# =============================================================================
# 1. REQUIRED SETTINGS (must be set before `docker compose up -d --wait`)
# =============================================================================

# Compose file targeted when running `docker compose` inside `deploy/compose/`.
# For the Cloudflare Tunnel variant in Section 2, replace this line with
# `COMPOSE_FILE=docker-compose.prod.yml:docker-compose.tunnel.yml`.
COMPOSE_FILE=docker-compose.prod.yml

# Public DNS name pointing at this machine with an IPv4 `A` record ONLY.
# Do NOT publish an `AAAA` (IPv6) record for direct Caddy bridge deployments:
# Docker's userland proxy rewrites inbound IPv6 peers to the IPv4 bridge gateway
# address, collapsing all IPv6 players into a single rate-limit bucket. (Use the
# Cloudflare Tunnel variant in Section 2 if you want IPv6 at the edge.)
# For `TRAME_DOMAIN=localhost`, Caddy automatically provisions a local TLS
# certificate from its internal CA instead of public ACME.
TRAME_DOMAIN=table.example.com

# Host ports published by Caddy (`[ADDRESS:]PORT`; placed above
# `TRAME_PUBLIC_ORIGIN` so `${CADDY_HTTPS_PORT}` expands cleanly in `.env`).
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Browser origin; must match the exact URL players open.
# Whenever `CADDY_HTTPS_PORT` is changed from `443` (e.g. `8443` for local
# evaluation or custom port forwarding), `TRAME_PUBLIC_ORIGIN` MUST include
# `:<port>` (for example `TRAME_PUBLIC_ORIGIN=https://localhost:8443` or
# `https://${TRAME_DOMAIN}:${CADDY_HTTPS_PORT}`), and `S3_PUBLIC_ENDPOINT` below
# (which defaults to `${TRAME_PUBLIC_ORIGIN}` for bundled Silo) must likewise
# carry that port so WebSocket `Origin` validation, Silo CORS
# (`Access-Control-Allow-Origin`), and presigned asset redirects match the
# browser's origin.
TRAME_PUBLIC_ORIGIN=https://${TRAME_DOMAIN}

# 64 hex characters (`openssl rand -hex 32`): AES-256-GCM key for TOTP secrets.
# Losing it invalidates enrolled TOTP authenticators.
MASTER_ENCRYPTION_KEY=
# At least 32 characters (`openssl rand -hex 32`): HMAC-SHA256 key signing
# presigned asset download URLs.
TRAME_JWT_SECRET=
# At least 32 characters (`openssl rand -hex 32`): separate reserved HMAC key
# still required by `trame-server` startup validation outside `TRAME_ENV=dev`.
TRAME_INVITE_JWT_SECRET=

# Bundled PostgreSQL password (`openssl rand -hex 32`).
POSTGRES_PASSWORD=

# Default asset storage: Option A, bundled Silo (`COMPOSE_PROFILES=silo`).
# Presigned downloads go through Caddy on the public origin (`S3_PUBLIC_ENDPOINT`).
# Set both credentials below (user >= 3 characters, password >= 8 characters),
# or switch to Option B / Option C in Section 2.
COMPOSE_PROFILES=silo
S3_ENDPOINT=http://silo:9000
S3_PUBLIC_ENDPOINT=${TRAME_PUBLIC_ORIGIN}
S3_BUCKET=trame-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# =============================================================================
# 2. OPTIONAL SETTINGS & VARIANTS (safe to leave as-is on first start)
# =============================================================================

# Optional: restrict the initial 1-hour Owner setup URL to this email address.
TRAME_BOOTSTRAP_OWNER_EMAIL=

# Optional off-machine backup copy (recommended: an R2 bucket separate from
# assets). Leave empty to keep nightly dumps on the local `backups` volume only.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=trame/postgres
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Daily pg_dump time (UTC, HH:MM) and retention in days (local and bucket).
BACKUP_TIME=03:00
BACKUP_RETENTION_DAYS=14

# Optional Cloudflare Tunnel variant (no published host ports; terminates both
# IPv4 and IPv6 safely at Cloudflare's edge): replace `COMPOSE_FILE` in Section 1
# with `COMPOSE_FILE=docker-compose.prod.yml:docker-compose.tunnel.yml` and set
# the tunnel's connector token.
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.tunnel.yml
CLOUDFLARE_TUNNEL_TOKEN=

# Optional alternative asset storage backends:
# - Option B, Cloudflare R2 (set `COMPOSE_PROFILES=` empty to disable Silo):
#     S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#     S3_PUBLIC_ENDPOINT=            (empty: browsers use S3_ENDPOINT)
#     S3_BUCKET=<bucket>
#     S3_REGION=auto
#     S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY = R2 API token (Object Read & Write)
#     Then set the bucket CORS rule (README: "Bucket CORS").
# - Option C, assets in PostgreSQL: set `COMPOSE_PROFILES=` empty and leave
#   every `S3_*` variable empty.

# Optional external PostgreSQL instead of the bundled `postgres` container
# (use `sslmode=verify-full` for remote servers; backups still use `PG*` unless overridden).
# DATABASE_URL=postgresql://user:password@db.example.com:5432/trame?sslmode=verify-full

# Runtime defaults (change only for custom images, database names, or log levels;
# Caddy host ports `CADDY_HTTP_PORT` and `CADDY_HTTPS_PORT` are in Section 1).
TRAME_IMAGE=trame-server:latest
POSTGRES_DB=trame
POSTGRES_USER=trame
TRAME_COOKIE_SECURE=true
RUST_LOG=info
