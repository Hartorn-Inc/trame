# TRAME production Compose settings. Copy to `deploy/compose/.env`, fill in,
# and keep it out of version control (`.env` is git-ignored): it holds secrets.
# Generate secrets with `openssl rand -hex 32` (64 hex characters).

# --- Compose -----------------------------------------------------------------
# Optional services: `silo` runs the bundled S3-compatible store.
COMPOSE_PROFILES=silo
# Cloudflare Tunnel variant (no published ports): uncomment.
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.tunnel.yml

# --- Edge (Caddy) ------------------------------------------------------------
# Public DNS name pointing at this machine (A/AAAA record); Caddy gets its certificate.
TRAME_DOMAIN=table.example.com
# Host ports, `[ADDRESS:]PORT`. Automatic HTTPS needs 80 and 443 reachable from the internet.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Tunnel variant only: connector token of the Cloudflare tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# --- trame-server --------------------------------------------------------------
# Production image (`docker build -t trame-server:latest .` at the repository root).
TRAME_IMAGE=trame-server:latest
# Browser origin; must match the URL players open.
TRAME_PUBLIC_ORIGIN=https://${TRAME_DOMAIN}
# 64 hex characters: AES-256-GCM key for TOTP secrets. Losing it disables enrolled TOTP.
MASTER_ENCRYPTION_KEY=
# At least 32 characters each.
TRAME_JWT_SECRET=
TRAME_INVITE_JWT_SECRET=
# Optional: only this email may claim the instance with the logged setup URL.
TRAME_BOOTSTRAP_OWNER_EMAIL=
TRAME_COOKIE_SECURE=true
RUST_LOG=info

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=trame
POSTGRES_USER=trame
POSTGRES_PASSWORD=
# Optional: external database instead of the bundled one (backups still target `postgres`).
# DATABASE_URL=

# --- Asset storage (S3) --------------------------------------------------------
# Option A, bundled Silo (`COMPOSE_PROFILES=silo`): presigned downloads go through
# Caddy on the public origin, so S3_PUBLIC_ENDPOINT is the public origin.
S3_ENDPOINT=http://silo:9000
S3_PUBLIC_ENDPOINT=${TRAME_PUBLIC_ORIGIN}
S3_BUCKET=trame-assets
S3_REGION=us-east-1
# Also Silo's root credentials: user >= 3 characters, password >= 8 characters.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Option B, Cloudflare R2 (remove `silo` from COMPOSE_PROFILES):
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_PUBLIC_ENDPOINT=            (empty: browsers use S3_ENDPOINT)
#   S3_BUCKET=<bucket>
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY = R2 API token (Object Read & Write)
#   Then set the bucket CORS rule (README: "Bucket CORS").
# Option C, assets in PostgreSQL: leave every S3_* variable empty and drop the `silo` profile.

# --- Backups -------------------------------------------------------------------
# Daily pg_dump time (UTC, HH:MM) and retention in days (local and bucket).
BACKUP_TIME=03:00
BACKUP_RETENTION_DAYS=14
# Off-machine copy (recommended: an R2 bucket separate from the assets). Empty = local only.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=trame/postgres
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
